---
// src/layouts/CmsLayout.astro
export interface Props {
  title?: string;
  activeMenu?: string;
}
const { title = 'CloudPress CMS', activeMenu = 'dashboard' } = Astro.props;

const menu = [
  { id: 'dashboard', href: '/admin',           icon: '🏠', label: '대시보드', children: [] },
  { id: 'posts',     href: '/admin/posts',      icon: '📝', label: '글', children: [
    { href: '/admin/posts',      label: '모든 글' },
    { href: '/admin/posts/new',  label: '새 글 쓰기' },
    { href: '/admin/categories', label: '카테고리' },
    { href: '/admin/tags',       label: '태그' },
  ]},
  { id: 'media',     href: '/admin/media',      icon: '🖼️', label: '미디어', children: [
    { href: '/admin/media',      label: '라이브러리' },
  ]},
  { id: 'pages',     href: '/admin/pages',      icon: '📄', label: '페이지', children: [
    { href: '/admin/pages',      label: '모든 페이지' },
    { href: '/admin/pages/new',  label: '새 페이지' },
  ]},
  { id: 'comments',  href: '/admin/comments',   icon: '💬', label: '댓글', children: [] },
  { id: 'themes',    href: '/admin/themes',      icon: '🎨', label: '외모', children: [
    { href: '/admin/themes',     label: '테마' },
    { href: '/admin/customize',  label: '커스터마이즈' },
  ]},
  { id: 'plugins',   href: '/admin/plugins',    icon: '🔌', label: '플러그인', children: [
    { href: '/admin/plugins',    label: '설치된 플러그인' },
  ]},
  { id: 'users',     href: '/admin/users',       icon: '👤', label: '사용자', children: [
    { href: '/admin/users',      label: '모든 사용자' },
    { href: '/admin/profile',    label: '내 프로필' },
  ]},
  { id: 'tools',     href: '/admin/tools',       icon: '🔧', label: '도구', children: [
    { href: '/admin/tools',      label: '사용 가능한 도구' },
  ]},
  { id: 'settings',  href: '/admin/settings',    icon: '⚙️', label: '설정', children: [
    { href: '/admin/settings',   label: '일반' },
  ]},
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} — CloudPress CMS</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:       #1d2327;
      --surface:  #2c3338;
      --border:   #3c434a;
      --blue:     #2271b1;
      --blue-h:   #135e96;
      --text:     #c3c4c7;
      --text-hi:  #ffffff;
      --sidebar-w:200px;
    }
    html, body { height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg); color: var(--text);
      display: flex; flex-direction: column; min-height: 100vh;
    }

    /* ── 상단 툴바 ───────────────────────────────────────────────── */
    #wpadminbar {
      position: fixed; top: 0; left: 0; right: 0; height: 32px;
      background: #1d2327; border-bottom: 1px solid #3c434a;
      display: flex; align-items: center; z-index: 200;
      font-size: 12px;
    }
    .ab-logo {
      display: flex; align-items: center; height: 32px;
      padding: 0 12px; color: #fff; font-weight: 800; font-size: 14px;
      text-decoration: none; border-right: 1px solid #3c434a; white-space: nowrap;
    }
    .ab-logo span { color: var(--blue); }
    .ab-item {
      display: flex; align-items: center; height: 32px; padding: 0 10px;
      color: var(--text); text-decoration: none; transition: background .1s, color .1s;
      border: none; background: transparent; cursor: pointer; white-space: nowrap;
    }
    .ab-item:hover { background: rgba(255,255,255,.06); color: #fff; }
    .ab-right { margin-left: auto; display: flex; align-items: center; border-left: 1px solid #3c434a; }
    .ab-user { padding: 0 12px; color: #8c8f94; font-size: 12px; }
    #pending-badge {
      background: #d63638; color: #fff; border-radius: 10px;
      padding: 0 5px; font-size: 10px; margin-left: 4px; display: none;
    }

    /* ── 사이드바 ────────────────────────────────────────────────── */
    #adminmenu-wrap {
      position: fixed; top: 32px; left: 0; bottom: 0; width: var(--sidebar-w);
      background: var(--surface); border-right: 1px solid var(--border);
      overflow-y: auto; overflow-x: hidden; z-index: 100;
      scrollbar-width: thin; scrollbar-color: var(--border) transparent;
    }
    #adminmenu-wrap::-webkit-scrollbar { width: 4px; }
    #adminmenu-wrap::-webkit-scrollbar-thumb { background: var(--border); }

    #adminmenu { list-style: none; }
    #adminmenu > li > a {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 10px 8px 14px;
      color: #eee; text-decoration: none; font-size: 13px;
      border-left: 3px solid transparent;
      transition: background .1s, color .1s;
    }
    #adminmenu > li > a:hover { background: rgba(255,255,255,.05); color: #fff; }
    #adminmenu > li.current > a,
    #adminmenu > li.has-current > a {
      background: var(--blue); color: #fff; border-left-color: #72aee6;
    }
    #adminmenu > li > a .mi { font-size: 14px; width: 20px; text-align: center; flex-shrink: 0; }
    #adminmenu > li > a .ml { flex: 1; }
    #adminmenu > li > a .ma { font-size: 9px; color: rgba(255,255,255,.35); transition: transform .2s; }
    #adminmenu > li.open > a .ma { transform: rotate(90deg); }

    /* 서브메뉴 */
    .wp-submenu { display: none; list-style: none; background: rgba(0,0,0,.2); }
    li.open .wp-submenu, li.has-current .wp-submenu { display: block; }
    .wp-submenu a {
      display: block; padding: 5px 10px 5px 42px;
      color: #c3c4c7; text-decoration: none; font-size: 12px;
      transition: color .1s;
    }
    .wp-submenu a:hover { color: #fff; }
    .wp-submenu li.sub-current a { color: #72aee6; font-weight: 700; }

    /* 사이드바 하단 접기 버튼 */
    #sidebar-footer {
      position: sticky; bottom: 0;
      padding: 10px 14px; border-top: 1px solid var(--border);
      background: var(--surface); cursor: pointer;
      display: flex; align-items: center; gap: 6px;
      font-size: 11px; color: #8c8f94;
    }
    #sidebar-footer:hover { color: #fff; }

    /* ── 메인 ────────────────────────────────────────────────────── */
    #wpcontent {
      margin-top: 32px; margin-left: var(--sidebar-w);
      flex: 1; display: flex; flex-direction: column; min-width: 0;
    }
    #wpbody { flex: 1; padding: 24px 24px 24px 24px; }
    #wpbody-content { max-width: 1200px; }

    /* ── 공통 컴포넌트 ──────────────────────────────────────────── */
    .wp-heading-inline { font-size: 23px; font-weight: 400; color: var(--text-hi); }
    .notice {
      background: var(--surface); border-left: 4px solid var(--blue);
      padding: 12px 16px; margin: 0 0 16px; font-size: 13px; border-radius: 0 4px 4px 0;
    }
    .notice-success { border-left-color: #00a32a; }
    .notice-error   { border-left-color: #d63638; }
    .notice-warning { border-left-color: #dba617; }

    /* 포스트박스 (플러그인 메타박스) */
    .postbox {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 4px; overflow: hidden; margin-bottom: 12px;
    }
    .postbox-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer;
    }
    .postbox-header h2 { font-size: 13px; font-weight: 700; color: var(--text-hi); }
    .postbox.closed .inside { display: none; }
    .postbox .inside { padding: 14px; }

    /* 하단 바 */
    #wpfooter {
      margin-left: var(--sidebar-w);
      padding: 10px 24px; border-top: 1px solid var(--border);
      font-size: 12px; color: #8c8f94; text-align: center;
    }

    /* ── 모바일 ─────────────────────────────────────────────────── */
    @media (max-width: 782px) {
      :root { --sidebar-w: 0px; }
      #adminmenu-wrap { transform: translateX(-200px); width: 200px; transition: transform .25s; }
      #adminmenu-wrap.open { transform: translateX(0); }
      #wpcontent, #wpfooter { margin-left: 0; }
      .mob-toggle { display: flex !important; }
    }
    .mob-toggle {
      display: none; background: none; border: none;
      color: var(--text); font-size: 18px; cursor: pointer; padding: 0 8px;
    }
    #mob-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.5); z-index: 99;
    }
    #mob-overlay.show { display: block; }
  </style>
</head>
<body>

  <!-- 상단 툴바 -->
  <div id="wpadminbar">
    <button class="mob-toggle ab-item" onclick="toggleMob()">☰</button>
    <a class="ab-logo" href="/admin">Cloud<span>Press</span></a>
    <a class="ab-item" href="/" target="_blank">🏠 사이트 보기</a>
    <a class="ab-item" href="/admin/posts/new">+ 새 글</a>
    <a class="ab-item" href="/admin/comments">
      💬 댓글 <span id="pending-badge"></span>
    </a>
    <div class="ab-right">
      <span class="ab-user">안녕하세요, <strong id="ab-user" style="color:#fff;"></strong>님</span>
      <button class="ab-item" onclick="logout()">로그아웃</button>
    </div>
  </div>

  <div id="mob-overlay" onclick="closeMob()"></div>

  <!-- 사이드바 -->
  <div id="adminmenu-wrap">
    <ul id="adminmenu">
      {menu.map(item => {
        const isCurrent = activeMenu === item.id;
        const hasChildren = item.children.length > 0;
        const liClass = isCurrent
          ? (hasChildren ? 'has-current open' : 'current')
          : '';
        return (
          <li class={liClass} id={`menu-${item.id}`}>
            <a
              href={hasChildren ? '#' : item.href}
              onclick={hasChildren ? `toggleSub('menu-${item.id}',event)` : ''}
            >
              <span class="mi">{item.icon}</span>
              <span class="ml">{item.label}</span>
              {hasChildren && <span class="ma">▶</span>}
            </a>
            {hasChildren && (
              <ul class="wp-submenu">
                {item.children.map((child: any) => (
                  <li>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
    <div id="sidebar-footer" onclick="collapseToggle()">
      <span id="col-arrow">◀</span>
      <span id="col-label">접기</span>
    </div>
  </div>

  <!-- 메인 -->
  <div id="wpcontent">
    <div id="wpbody">
      <div id="wpbody-content">
        <slot />
      </div>
    </div>
  </div>

  <div id="wpfooter">
    CloudPress CMS &nbsp;|&nbsp; WordPress 완전 호환 &nbsp;|&nbsp; Cloudflare Workers
  </div>

  <script>
    // ── 세션 확인 ────────────────────────────────────────────────
    (async function() {
      try {
        const res  = await fetch('/api/auth/me');
        if (!res.ok) { window.location.href = '/login'; return; }
        const data = await res.json();
        if (!data.user) { window.location.href = '/login'; return; }
        document.getElementById('ab-user').textContent =
          data.user.display_name || data.user.user_login || '';
      } catch { window.location.href = '/login'; }
    })();

    // ── 대기 댓글 배지 ───────────────────────────────────────────
    (async function() {
      try {
        const res  = await fetch('/api/comments?status=0&per_page=1');
        if (!res.ok) return;
        const data = await res.json();
        const cnt  = data.total_pending || 0;
        if (cnt > 0) {
          const b = document.getElementById('pending-badge');
          b.textContent = String(cnt);
          b.style.display = 'inline';
        }
      } catch {}
    })();

    async function logout() {
      await fetch('/api/auth/logout', { method: 'POST' }).catch(() => {});
      window.location.href = '/login';
    }

    // ── 서브메뉴 ────────────────────────────────────────────────
    function toggleSub(id, e) {
      e.preventDefault();
      document.getElementById(id).classList.toggle('open');
    }

    // ── 현재 서브메뉴 항목 표시 ─────────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
      const path = location.pathname;
      document.querySelectorAll('.wp-submenu a').forEach(a => {
        if (a.getAttribute('href') === path) {
          a.closest('li').classList.add('sub-current');
        }
      });
    });

    // ── 사이드바 접기 ───────────────────────────────────────────
    let collapsed = localStorage.getItem('cp_col') === '1';
    function collapseToggle() {
      collapsed = !collapsed;
      localStorage.setItem('cp_col', collapsed ? '1' : '0');
      applyCollapse();
    }
    function applyCollapse() {
      const w = document.getElementById('adminmenu-wrap');
      const c = document.getElementById('wpcontent');
      const f = document.getElementById('wpfooter');
      const lbl = document.getElementById('col-label');
      const arr = document.getElementById('col-arrow');
      if (collapsed) {
        document.documentElement.style.setProperty('--sidebar-w', '36px');
        w.style.overflow = 'hidden';
        document.querySelectorAll('#adminmenu .ml,#adminmenu .ma,.wp-submenu,.col-label').forEach(el => {
          (el as HTMLElement).style.display = 'none';
        });
        arr.textContent = '▶'; lbl.textContent = '';
      } else {
        document.documentElement.style.setProperty('--sidebar-w', '200px');
        w.style.overflow = '';
        document.querySelectorAll('#adminmenu .ml,#adminmenu .ma').forEach(el => {
          (el as HTMLElement).style.display = '';
        });
        arr.textContent = '◀'; lbl.textContent = '접기';
      }
    }
    if (collapsed) applyCollapse();

    // ── 모바일 ─────────────────────────────────────────────────
    function toggleMob() {
      document.getElementById('adminmenu-wrap').classList.toggle('open');
      document.getElementById('mob-overlay').classList.toggle('show');
    }
    function closeMob() {
      document.getElementById('adminmenu-wrap').classList.remove('open');
      document.getElementById('mob-overlay').classList.remove('show');
    }

    // ── 메타박스 클릭 ───────────────────────────────────────────
    document.addEventListener('click', function(e) {
      const h = (e.target as Element).closest('.postbox-header');
      if (h) h.closest('.postbox').classList.toggle('closed');
    });

    // ── 플러그인 메뉴 동적 로드 ─────────────────────────────────
    (async function() {
      try {
        const res = await fetch('/api/plugin-menus');
        if (!res.ok) return;
        const data = await res.json();
        const menus = data.menus || [];
        if (!menus.length) return;
        const ul = document.getElementById('adminmenu');
        menus.forEach((m: any) => {
          const li = document.createElement('li');
          li.innerHTML = `<a href="${m.url}"><span class="mi">${m.icon||'🔌'}</span><span class="ml">${m.title}</span></a>`;
          ul.appendChild(li);
        });
      } catch {}
    })();
  </script>
</body>
</html>
