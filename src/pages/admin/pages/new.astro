---
// src/pages/admin/pages/new.astro
export const prerender = false;
import CmsLayout from '../../../layouts/CmsLayout.astro';
---
<CmsLayout title="새 페이지" activeMenu="pages">
  <style>
    .editor-wrap { display:grid;grid-template-columns:1fr 280px;gap:20px;align-items:start; }
    .editor-main,.editor-sidebar { display:flex;flex-direction:column;gap:16px; }
    .card { background:#2c3338;border:1px solid #3c434a;border-radius:12px;padding:20px; }
    .card-title { font-size:13px;font-weight:700;color:#8c8f94;text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px; }
    .page-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:20px; }
    h2 { font-size:20px;font-weight:700;color:#fff; }
    .header-actions { display:flex;gap:8px; }
    .btn { border-radius:8px;padding:9px 18px;font-size:13px;font-weight:700;cursor:pointer;border:none;transition:background .15s; }
    .btn-draft   { background:#3c434a;color:#c3c4c7; }
    .btn-draft:hover { background:#4a545e; }
    .btn-publish { background:#2271b1;color:#fff; }
    .btn-publish:hover { background:#135e96; }
    .btn:disabled { opacity:.5;cursor:not-allowed; }
    input[type="text"],textarea,select { width:100%;background:#1d2327;border:1px solid #3c434a;border-radius:8px;padding:10px 14px;color:#fff;font-size:14px;outline:none;transition:border-color .2s;font-family:inherit; }
    input:focus,textarea:focus,select:focus { border-color:#2271b1; }
    #post-title { font-size:22px;font-weight:700;padding:14px 16px; }
    .toolbar { display:flex;flex-wrap:wrap;gap:4px;padding:10px 12px;background:#1d2327;border:1px solid #3c434a;border-radius:8px 8px 0 0;border-bottom:none; }
    .tb-btn { background:transparent;border:1px solid transparent;border-radius:5px;color:#c3c4c7;padding:5px 8px;font-size:13px;cursor:pointer;transition:all .15s;font-weight:600; }
    .tb-btn:hover { background:rgba(255,255,255,.08);border-color:#3c434a;color:#fff; }
    .tb-sep { width:1px;background:#3c434a;margin:4px 2px;align-self:stretch; }
    #post-content { border-radius:0 0 8px 8px;resize:vertical;min-height:420px;font-family:'Consolas','Monaco',monospace;font-size:14px;line-height:1.7; }
    .tab-bar { display:flex;gap:2px; }
    .tab { padding:8px 16px;font-size:12px;font-weight:700;cursor:pointer;border-radius:7px 7px 0 0;border:1px solid transparent;color:#8c8f94;background:transparent;transition:all .15s; }
    .tab.active { background:#1d2327;border-color:#3c434a #3c434a #1d2327;color:#fff; }
    #preview-pane { display:none;background:#1d2327;border:1px solid #3c434a;border-radius:0 8px 8px 8px;padding:20px;min-height:420px;color:#c3c4c7;line-height:1.8;font-size:14px; }
    #preview-pane h1,#preview-pane h2,#preview-pane h3 { color:#fff;margin:16px 0 8px; }
    #preview-pane p { margin-bottom:12px; }
    label { display:block;font-size:12px;color:#8c8f94;font-weight:600;margin-bottom:6px; }
    .alert { padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px;display:none; }
    .alert.ok    { background:#1a3020;border:1px solid #208b45;color:#4ade80;display:block; }
    .alert.error { background:#3b1f1f;border:1px solid #8b2020;color:#f87171;display:block; }
    @media(max-width:768px){ .editor-wrap{grid-template-columns:1fr;} }
  </style>

  <div class="page-header">
    <div style="display:flex;align-items:center;gap:12px;">
      <a href="/admin/pages" style="color:#8c8f94;text-decoration:none;font-size:13px;">← 페이지 목록</a>
      <h2>새 페이지</h2>
    </div>
    <div class="header-actions">
      <button class="btn btn-draft"   id="btn-draft"   onclick="savePage('draft')">임시저장</button>
      <button class="btn btn-publish" id="btn-publish" onclick="savePage('publish')">발행</button>
    </div>
  </div>

  <div id="alert" class="alert"></div>

  <div class="editor-wrap">
    <div class="editor-main">
      <input id="post-title" type="text" placeholder="페이지 제목을 입력하세요" />
      <div>
        <div class="tab-bar">
          <button class="tab active" onclick="switchTab('edit',this)">편집</button>
          <button class="tab" onclick="switchTab('preview',this)">미리보기</button>
        </div>
        <div class="toolbar">
          <button class="tb-btn" onclick="fmt('bold')"><b>B</b></button>
          <button class="tb-btn" onclick="fmt('italic')"><i>I</i></button>
          <button class="tb-btn" onclick="fmtLink()">🔗</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtH(2)">H2</button>
          <button class="tb-btn" onclick="fmtH(3)">H3</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtList('ul')">• 목록</button>
          <button class="tb-btn" onclick="fmtList('ol')">1. 목록</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtBlock('blockquote')">❝</button>
          <button class="tb-btn" onclick="fmtBlock('code')">&#60;/&#62;</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtHr()">─ 구분선</button>
        </div>
        <textarea id="post-content" placeholder="페이지 내용을 입력하세요...&#10;&#10;마크다운을 지원합니다."></textarea>
        <div id="preview-pane"></div>
      </div>
    </div>

    <div class="editor-sidebar">
      <div class="card">
        <div class="card-title">페이지 설정</div>
        <div style="margin-bottom:12px;">
          <label>상태</label>
          <select id="post-status">
            <option value="draft">임시저장</option>
            <option value="publish">발행됨</option>
          </select>
        </div>
        <div style="margin-bottom:12px;">
          <label>URL 슬러그</label>
          <input id="post-slug" type="text" placeholder="자동 생성 (예: about-us)" />
        </div>
        <div>
          <label>페이지 순서</label>
          <input id="post-order" type="number" placeholder="0" min="0" style="width:80px;" />
        </div>
      </div>
      <div class="card">
        <div class="card-title">대표 이미지</div>
        <div id="feat-img-preview" style="display:none;margin-bottom:10px;">
          <img id="feat-img" src="" style="width:100%;border-radius:8px;object-fit:cover;max-height:160px;" />
        </div>
        <input id="feat-img-url" type="text" placeholder="이미지 URL" oninput="previewFeatImg(this.value)" />
      </div>
      <div class="card">
        <div class="card-title">SEO</div>
        <div style="margin-bottom:12px;">
          <label>SEO 제목</label>
          <input id="seo-title" type="text" placeholder="검색 결과에 표시될 제목" />
        </div>
        <div>
          <label>메타 설명</label>
          <textarea id="seo-desc" rows="3" placeholder="검색 결과에 표시될 설명 (160자 이내)"></textarea>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('post-title').addEventListener('input', function() {
      const slug = document.getElementById('post-slug');
      if (!slug.dataset.manual) {
        slug.value = this.value.toLowerCase().replace(/[^a-z0-9가-힣\s-]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-');
      }
    });
    document.getElementById('post-slug').addEventListener('input', function() { this.dataset.manual = '1'; });

    function switchTab(tab, btn) {
      document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active')); btn.classList.add('active');
      const ed=document.getElementById('post-content'),pr=document.getElementById('preview-pane'),tb=document.querySelector('.toolbar');
      if(tab==='preview'){ed.style.display='none';tb.style.display='none';pr.style.display='block';pr.innerHTML=renderMd(ed.value);}
      else{ed.style.display='block';tb.style.display='flex';pr.style.display='none';}
    }
    function renderMd(md){if(!md)return'<p style="color:#4a545e;">미리볼 내용이 없습니다.</p>';return md.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/^#{3} (.+)$/gm,'<h3>$1</h3>').replace(/^#{2} (.+)$/gm,'<h2>$1</h2>').replace(/^# (.+)$/gm,'<h1>$1</h1>').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\[(.+?)\]\((.+?)\)/g,'<a href="$2">$1</a>').replace(/^---$/gm,'<hr>').replace(/\n\n/g,'</p><p>');}
    function fmt(t){const ta=document.getElementById('post-content'),s=ta.selectionStart,e=ta.selectionEnd,sel=ta.value.slice(s,e),w={bold:'**',italic:'*'}[t];ta.setRangeText(sel?`${w}${sel}${w}`:`${w}텍스트${w}`,s,e,'end');ta.focus();}
    function fmtH(l){const ta=document.getElementById('post-content'),s=ta.selectionStart,ls=ta.value.lastIndexOf('\n',s-1)+1;ta.setRangeText('#'.repeat(l)+' ',ls,ls,'end');ta.focus();}
    function fmtList(t){const ta=document.getElementById('post-content'),s=ta.selectionStart,e=ta.selectionEnd,sel=ta.value.slice(s,e)||'항목 1\n항목 2',lines=sel.split('\n'),f=lines.map((l,i)=>t==='ol'?`${i+1}. ${l}`:`- ${l}`).join('\n');ta.setRangeText('\n'+f+'\n',s,e,'end');ta.focus();}
    function fmtBlock(t){const ta=document.getElementById('post-content'),s=ta.selectionStart,e=ta.selectionEnd,sel=ta.value.slice(s,e)||'내용',rep=t==='code'?`\`\`\`\n${sel}\n\`\`\``:`> ${sel}`;ta.setRangeText(rep,s,e,'end');ta.focus();}
    function fmtLink(){const ta=document.getElementById('post-content'),s=ta.selectionStart,e=ta.selectionEnd,sel=ta.value.slice(s,e)||'링크 텍스트',url=prompt('URL:','https://');if(!url)return;ta.setRangeText(`[${sel}](${url})`,s,e,'end');ta.focus();}
    function fmtHr(){const ta=document.getElementById('post-content'),s=ta.selectionStart;ta.setRangeText('\n\n---\n\n',s,s,'end');ta.focus();}
    function previewFeatImg(url){const p=document.getElementById('feat-img-preview'),i=document.getElementById('feat-img');if(url){i.src=url;p.style.display='block';}else p.style.display='none';}

    async function savePage(status) {
      const alertEl = document.getElementById('alert');
      alertEl.className = 'alert';
      const title = document.getElementById('post-title').value.trim();
      if (!title) { alertEl.className='alert error'; alertEl.textContent='제목을 입력해주세요.'; return; }
      ['btn-draft','btn-publish'].forEach(id=>{document.getElementById(id).disabled=true;});
      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            post_title:   title,
            post_content: document.getElementById('post-content').value,
            post_status:  status,
            post_type:    'page',
            post_name:    document.getElementById('post-slug').value || undefined,
            menu_order:   parseInt(document.getElementById('post-order').value) || 0,
            _thumbnail_url: document.getElementById('feat-img-url').value || undefined,
            _seo_title:   document.getElementById('seo-title').value || undefined,
            _seo_desc:    document.getElementById('seo-desc').value || undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');
        window.location.href = `/admin/pages/${data.post.ID}/edit?saved=1`;
      } catch (e) {
        alertEl.className = 'alert error'; alertEl.textContent = e.message;
      } finally {
        ['btn-draft','btn-publish'].forEach(id=>{document.getElementById(id).disabled=false;});
      }
    }
  </script>
</CmsLayout>
