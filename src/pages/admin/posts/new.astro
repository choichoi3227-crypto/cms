---
// src/pages/admin/posts/new.astro
export const prerender = false;
import CmsLayout from '../../../layouts/CmsLayout.astro';
---
<CmsLayout title="새 글 쓰기" activeMenu="posts">
  <style>
    .editor-wrap { display: grid; grid-template-columns: 1fr 280px; gap: 20px; align-items: start; }
    .editor-main { display: flex; flex-direction: column; gap: 16px; }
    .editor-sidebar { display: flex; flex-direction: column; gap: 16px; }
    .card { background: #2c3338; border: 1px solid #3c434a; border-radius: 12px; padding: 20px; }
    .card-title { font-size: 13px; font-weight: 700; color: #8c8f94; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 14px; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    h2 { font-size: 20px; font-weight: 700; color: #fff; }
    .header-actions { display: flex; gap: 8px; }
    .btn { border-radius: 8px; padding: 9px 18px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; transition: background .15s; }
    .btn-draft   { background: #3c434a; color: #c3c4c7; }
    .btn-draft:hover { background: #4a545e; }
    .btn-publish { background: #2271b1; color: #fff; }
    .btn-publish:hover { background: #135e96; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    input[type="text"], textarea, select {
      width: 100%; background: #1d2327; border: 1px solid #3c434a;
      border-radius: 8px; padding: 10px 14px; color: #fff; font-size: 14px;
      outline: none; transition: border-color .2s; font-family: inherit;
    }
    input:focus, textarea:focus, select:focus { border-color: #2271b1; }
    #post-title { font-size: 22px; font-weight: 700; padding: 14px 16px; }
    #post-title::placeholder { color: #4a545e; }
    .toolbar {
      display: flex; flex-wrap: wrap; gap: 4px;
      padding: 10px 12px; background: #1d2327;
      border: 1px solid #3c434a; border-radius: 8px 8px 0 0; border-bottom: none;
    }
    .tb-btn {
      background: transparent; border: 1px solid transparent; border-radius: 5px;
      color: #c3c4c7; padding: 5px 8px; font-size: 13px; cursor: pointer;
      transition: all .15s; font-weight: 600; min-width: 28px;
    }
    .tb-btn:hover { background: rgba(255,255,255,.08); border-color: #3c434a; color: #fff; }
    .tb-sep { width: 1px; background: #3c434a; margin: 4px 2px; align-self: stretch; }
    #post-content {
      border-radius: 0 0 8px 8px;
      resize: vertical;
      min-height: 380px;
      font-family: 'Consolas', 'Monaco', monospace;
      font-size: 14px;
      line-height: 1.7;
    }
    .tab-bar { display: flex; gap: 2px; margin-bottom: 0; }
    .tab {
      padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer;
      border-radius: 7px 7px 0 0; border: 1px solid transparent;
      color: #8c8f94; background: transparent; transition: all .15s;
    }
    .tab.active { background: #1d2327; border-color: #3c434a #3c434a #1d2327; color: #fff; }
    #preview-pane {
      display: none; background: #1d2327; border: 1px solid #3c434a;
      border-radius: 0 8px 8px 8px; padding: 20px; min-height: 400px;
      color: #c3c4c7; line-height: 1.8; font-size: 14px;
    }
    #preview-pane h1,#preview-pane h2,#preview-pane h3 { color: #fff; margin: 16px 0 8px; }
    #preview-pane p { margin-bottom: 12px; }
    #preview-pane a { color: #2271b1; }
    #preview-pane code { background: #2c3338; padding: 2px 6px; border-radius: 4px; font-family: monospace; }
    #preview-pane pre { background: #2c3338; padding: 16px; border-radius: 8px; overflow-x: auto; margin-bottom: 12px; }
    label { display: block; font-size: 12px; color: #8c8f94; font-weight: 600; margin-bottom: 6px; }
    .status-info { font-size: 12px; color: #8c8f94; margin-top: 8px; }
    .autosave-hint { font-size: 11px; color: #4a545e; text-align: right; margin-top: 4px; }
    .alert { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 12px; display: none; }
    .alert.ok    { background: #1a3020; border: 1px solid #208b45; color: #4ade80; display: block; }
    .alert.error { background: #3b1f1f; border: 1px solid #8b2020; color: #f87171; display: block; }
    @media(max-width:768px) { .editor-wrap { grid-template-columns: 1fr; } }
  </style>

  <div class="page-header">
    <h2>새 글 쓰기</h2>
    <div class="header-actions">
      <button class="btn btn-draft"   id="btn-draft"   onclick="savePost('draft')">임시저장</button>
      <button class="btn btn-publish" id="btn-publish" onclick="savePost('publish')">발행</button>
    </div>
  </div>

  <div id="alert" class="alert"></div>

  <div class="editor-wrap">
    <!-- 왼쪽: 에디터 -->
    <div class="editor-main">
      <input id="post-title" type="text" placeholder="제목을 입력하세요" />

      <div>
        <div class="tab-bar">
          <button class="tab active" onclick="switchTab('edit',this)">편집</button>
          <button class="tab" onclick="switchTab('preview',this)">미리보기</button>
        </div>
        <div class="toolbar" id="toolbar">
          <button class="tb-btn" title="굵게" onclick="fmt('bold')"><b>B</b></button>
          <button class="tb-btn" title="기울임" onclick="fmt('italic')"><i>I</i></button>
          <button class="tb-btn" title="링크" onclick="fmtLink()">🔗</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtHeading(2)">H2</button>
          <button class="tb-btn" onclick="fmtHeading(3)">H3</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtList('ul')">• 목록</button>
          <button class="tb-btn" onclick="fmtList('ol')">1. 목록</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtBlock('blockquote')">❝</button>
          <button class="tb-btn" onclick="fmtBlock('code')">{'</>'}</button>
          <div class="tb-sep"></div>
          <button class="tb-btn" onclick="fmtImage()">🖼️</button>
        </div>
        <textarea id="post-content" placeholder="여기에 내용을 작성하세요...&#10;&#10;마크다운을 지원합니다:&#10;## 제목  **굵게**  *기울임*  [링크](url)"></textarea>
        <div id="preview-pane"></div>
        <div class="autosave-hint" id="autosave-hint"></div>
      </div>

      <!-- 발췌문 -->
      <div class="card">
        <div class="card-title">발췌문</div>
        <textarea id="post-excerpt" rows="3" placeholder="글의 요약을 입력하세요 (선택 사항)"></textarea>
      </div>
    </div>

    <!-- 오른쪽: 사이드바 -->
    <div class="editor-sidebar">
      <div class="card">
        <div class="card-title">발행 설정</div>
        <div style="margin-bottom:12px;">
          <label>상태</label>
          <select id="post-status">
            <option value="draft">임시저장</option>
            <option value="publish">발행됨</option>
            <option value="private">비공개</option>
          </select>
        </div>
        <div>
          <label>URL 슬러그</label>
          <input id="post-slug" type="text" placeholder="자동 생성" />
        </div>
        <div class="status-info" id="status-info">아직 저장되지 않았습니다.</div>
      </div>

      <div class="card">
        <div class="card-title">카테고리</div>
        <div id="categories-list" style="font-size:13px;color:#8c8f94;">로딩 중...</div>
      </div>

      <div class="card">
        <div class="card-title">태그</div>
        <input id="post-tags" type="text" placeholder="태그 입력 후 쉼표로 구분" />
        <div style="font-size:11px;color:#4a545e;margin-top:6px;">예: 뉴스, 기술, 일상</div>
      </div>

      <div class="card">
        <div class="card-title">대표 이미지</div>
        <div id="feat-img-preview" style="display:none;margin-bottom:10px;">
          <img id="feat-img" src="" style="width:100%;border-radius:8px;object-fit:cover;max-height:160px;" />
        </div>
        <input id="feat-img-url" type="text" placeholder="이미지 URL 입력" oninput="previewFeatImg(this.value)" />
      </div>
    </div>
  </div>

  <script>
    let currentTab = 'edit';
    let autosaveTimer = null;
    const hint = document.getElementById('autosave-hint');

    // ── 탭 전환 ──────────────────────────────────────────────────────────
    function switchTab(tab, btn) {
      currentTab = tab;
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      const editor  = document.getElementById('post-content');
      const preview = document.getElementById('preview-pane');
      const toolbar = document.getElementById('toolbar');
      if (tab === 'preview') {
        editor.style.display  = 'none';
        toolbar.style.display = 'none';
        preview.style.display = 'block';
        preview.innerHTML = renderMd(editor.value);
      } else {
        editor.style.display  = 'block';
        toolbar.style.display = 'flex';
        preview.style.display = 'none';
      }
    }

    // ── 마크다운 → HTML 변환 (간이) ────────────────────────────────────
    function renderMd(md) {
      if (!md) return '<p style="color:#4a545e;">미리볼 내용이 없습니다.</p>';
      return md
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/^#{3} (.+)$/gm, '<h3>$1</h3>')
        .replace(/^#{2} (.+)$/gm, '<h2>$1</h2>')
        .replace(/^# (.+)$/gm,   '<h1>$1</h1>')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g,     '<em>$1</em>')
        .replace(/`([^`]+)`/g,     '<code>$1</code>')
        .replace(/\[(.+?)\]\((.+?)\)/g, '<a href="$2">$1</a>')
        .replace(/^> (.+)$/gm, '<blockquote style="border-left:3px solid #2271b1;padding-left:12px;margin:8px 0;color:#8c8f94;">$1</blockquote>')
        .replace(/^[-*] (.+)$/gm, '<li>$1</li>')
        .replace(/(<li>.*<\/li>)/s, '<ul style="padding-left:20px;">$1</ul>')
        .replace(/\n\n/g, '</p><p>')
        .replace(/^(?!<[h|u|o|l|b])/gm, '')
        .replace(/(.+[^>])$/gm, '<p>$1</p>');
    }

    // ── 텍스트 포매팅 ────────────────────────────────────────────────────
    function fmt(type) {
      const ta    = document.getElementById('post-content');
      const start = ta.selectionStart, end = ta.selectionEnd;
      const sel   = ta.value.slice(start, end);
      const wrap  = { bold: '**', italic: '*' }[type];
      const replacement = sel ? `${wrap}${sel}${wrap}` : `${wrap}텍스트${wrap}`;
      ta.setRangeText(replacement, start, end, 'end');
      ta.focus();
    }
    function fmtHeading(level) {
      const ta    = document.getElementById('post-content');
      const start = ta.selectionStart;
      const lineStart = ta.value.lastIndexOf('\n', start - 1) + 1;
      const prefix = '#'.repeat(level) + ' ';
      ta.setRangeText(prefix, lineStart, lineStart, 'end');
      ta.focus();
    }
    function fmtList(type) {
      const ta    = document.getElementById('post-content');
      const start = ta.selectionStart, end = ta.selectionEnd;
      const sel   = ta.value.slice(start, end);
      const lines = (sel || '항목 1\n항목 2').split('\n');
      const formatted = lines.map((l, i) => type === 'ol' ? `${i+1}. ${l}` : `- ${l}`).join('\n');
      ta.setRangeText('\n' + formatted + '\n', start, end, 'end');
      ta.focus();
    }
    function fmtBlock(type) {
      const ta    = document.getElementById('post-content');
      const start = ta.selectionStart, end = ta.selectionEnd;
      const sel   = ta.value.slice(start, end) || '내용';
      const rep   = type === 'code' ? `\`\`\`\n${sel}\n\`\`\`` : `> ${sel}`;
      ta.setRangeText(rep, start, end, 'end');
      ta.focus();
    }
    function fmtLink() {
      const ta    = document.getElementById('post-content');
      const start = ta.selectionStart, end = ta.selectionEnd;
      const sel   = ta.value.slice(start, end) || '링크 텍스트';
      const url   = prompt('URL을 입력하세요:', 'https://');
      if (!url) return;
      ta.setRangeText(`[${sel}](${url})`, start, end, 'end');
      ta.focus();
    }
    function fmtImage() {
      const url = prompt('이미지 URL을 입력하세요:', 'https://');
      if (!url) return;
      const ta  = document.getElementById('post-content');
      const pos = ta.selectionStart;
      ta.setRangeText(`\n![이미지](${url})\n`, pos, pos, 'end');
      ta.focus();
    }

    // ── 제목 → 슬러그 자동 생성 ─────────────────────────────────────────
    document.getElementById('post-title').addEventListener('input', function() {
      const slug = document.getElementById('post-slug');
      if (!slug.dataset.manual) {
        slug.value = this.value.toLowerCase()
          .replace(/[^a-z0-9가-힣\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-');
      }
      scheduleAutosave();
    });
    document.getElementById('post-slug').addEventListener('input', function() {
      this.dataset.manual = '1';
    });
    document.getElementById('post-content').addEventListener('input', scheduleAutosave);

    // ── 대표 이미지 미리보기 ────────────────────────────────────────────
    function previewFeatImg(url) {
      const preview = document.getElementById('feat-img-preview');
      const img     = document.getElementById('feat-img');
      if (url) { img.src = url; preview.style.display = 'block'; }
      else       preview.style.display = 'none';
    }

    // ── 자동저장 ────────────────────────────────────────────────────────
    function scheduleAutosave() {
      clearTimeout(autosaveTimer);
      hint.textContent = '자동저장 대기 중...';
      autosaveTimer = setTimeout(() => savePost('draft', true), 30000);
    }

    // ── 저장 ────────────────────────────────────────────────────────────
    async function savePost(status, isAuto = false) {
      const title   = document.getElementById('post-title').value.trim();
      const content = document.getElementById('post-content').value;
      const alertEl = document.getElementById('alert');
      alertEl.className = 'alert';

      if (!title && !isAuto) {
        alertEl.className = 'alert error';
        alertEl.textContent = '제목을 입력해주세요.';
        return;
      }

      ['btn-draft','btn-publish'].forEach(id => { document.getElementById(id).disabled = true; });

      try {
        const payload = {
          post_title:   title || '(제목 없음)',
          post_content: content,
          post_excerpt: document.getElementById('post-excerpt').value,
          post_status:  status,
          post_name:    document.getElementById('post-slug').value || undefined,
          tags_input:   document.getElementById('post-tags').value,
          _thumbnail_url: document.getElementById('feat-img-url').value || undefined,
        };

        const res  = await fetch('/api/posts', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');

        if (!isAuto) {
          // 저장 후 편집 페이지로 이동
          window.location.href = `/admin/posts/${data.post.ID}/edit?saved=1`;
        } else {
          hint.textContent = `자동저장: ${new Date().toLocaleTimeString('ko-KR')}`;
        }
      } catch (e) {
        alertEl.className = 'alert error';
        alertEl.textContent = e.message;
      } finally {
        ['btn-draft','btn-publish'].forEach(id => { document.getElementById(id).disabled = false; });
      }
    }

    // ── 카테고리 로드 ────────────────────────────────────────────────────
    async function loadCategories() {
      try {
        const res  = await fetch('/api/terms?taxonomy=category');
        const data = await res.json();
        const cats = data.terms || [];
        const el   = document.getElementById('categories-list');
        if (!cats.length) { el.textContent = '카테고리 없음'; return; }
        el.innerHTML = cats.map(c => `
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;margin-bottom:6px;font-size:13px;color:#c3c4c7;">
            <input type="checkbox" value="${c.term_id}" style="width:auto;">
            ${escHtml(c.name)} (${c.count || 0})
          </label>`).join('');
      } catch { document.getElementById('categories-list').textContent = '로드 실패'; }
    }
    function escHtml(s) { return String(s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    loadCategories();
  </script>
</CmsLayout>
