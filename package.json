{
  "name": "cloudpress-cms",
  "version": "1.0.0",
  "description": "CloudPress CMS — WordPress-compatible CMS on Cloudflare Pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute cloudpress-cms-db --remote --file=schema.sql",
    "logs": "wrangler tail",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.2.0",
    "astro": "^4.16.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250430.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
