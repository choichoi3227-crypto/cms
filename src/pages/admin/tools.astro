        astroBar(50);

        // 글 파일 생성
        function htmlToMarkdown(html) {
          if (!html) return '';
          return html
            .replace(/<br\s*\/?>/gi, '\n')
            .replace(/<\/p>/gi, '\n\n')
            .replace(/<p[^>]*>/gi, '')
            .replace(/<\/?(strong|b)>/gi, '**')
            .replace(/<\/?(em|i)>/gi, '_')
            .replace(/<h([1-6])[^>]*>(.*?)<\/h\1>/gi, (_, n, t) => '#'.repeat(+n) + ' ' + t.replace(/<[^>]+>/g,'') + '\n')
            .replace(/<a[^>]+href="([^"]*)"[^>]*>(.*?)<\/a>/gi, '[$2]($1)')
            .replace(/<img[^>]+src="([^"]*)"[^>]*(?:alt="([^"]*)")?[^>]*\/?>/gi, '![$2]($1)')
            .replace(/<pre[^>]*><code[^>]*>([\s\S]*?)<\/code><\/pre>/gi, '```\n$1\n```')
            .replace(/<code[^>]*>(.*?)<\/code>/gi, '`$1`')
            .replace(/<ul[^>]*>([\s\S]*?)<\/ul>/gi, (_, c) => c.replace(/<li[^>]*>(.*?)<\/li>/gi, '- $1\n'))
            .replace(/<ol[^>]*>([\s\S]*?)<\/ol>/gi, (_, c) => { let i=0; return c.replace(/<li[^>]*>(.*?)<\/li>/gi, () => `${++i}. $1\n`); })
            .replace(/<blockquote[^>]*>([\s\S]*?)<\/blockquote>/gi, (_, c) => c.split('\n').map(l=>('> '+l.replace(/<[^>]+>/g,'').trim())).join('\n'))
            .replace(/<[^>]+>/g, '')
            .replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'"').replace(/&#039;/g,"'").replace(/&nbsp;/g,' ')
            .replace(/\n{3,}/g, '\n\n')
            .trim();
