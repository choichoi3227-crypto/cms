{
  "name": "cloudpress-cms",
  "version": "1.0.0",
  "description": "CloudPress CMS — WordPress 호환 CMS (Astro → 순수 HTML5 변환)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev worker/src/index.ts --port 8787",
