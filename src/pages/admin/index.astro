---
export const prerender = false;
import CmsLayout from '../../layouts/CmsLayout.astro';
---
<CmsLayout title="대시보드" activeMenu="dashboard">
  <style>
    .wrap-heading { margin-bottom: 20px; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .stat { background: #2c3338; border: 1px solid #3c434a; border-radius: 8px; padding: 18px; text-align: center; }
    .stat-num { font-size: 30px; font-weight: 800; color: #fff; }
    .stat-lbl { font-size: 12px; color: #8c8f94; margin-top: 4px; }
    .quick { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; margin-bottom: 24px; }
    .qbtn {
      background: #2c3338; border: 1px solid #3c434a; border-radius: 8px;
      padding: 14px; text-align: center; text-decoration: none; color: #c3c4c7;
      font-size: 13px; font-weight: 600; transition: all .15s; display: block;
    }
    .qbtn:hover { background: rgba(34,113,177,.15); border-color: #2271b1; color: #fff; }
    .qbtn .qi { font-size: 20px; display: block; margin-bottom: 5px; }
    .recent { background: #2c3338; border: 1px solid #3c434a; border-radius: 8px; overflow: hidden; }
    .recent-hd { padding: 14px 18px; border-bottom: 1px solid #3c434a; font-weight: 700; color: #fff; font-size: 14px; }
    .recent-row { display: flex; align-items: center; gap: 12px; padding: 11px 18px; border-bottom: 1px solid rgba(255,255,255,.04); }
    .recent-row:last-child { border-bottom: none; }
    .recent-title { color: #2271b1; text-decoration: none; font-weight: 600; font-size: 13px; }
    .recent-title:hover { text-decoration: underline; }
    .recent-meta { font-size: 11px; color: #8c8f94; margin-top: 2px; }
    .recent-date { font-size: 11px; color: #8c8f94; margin-left: auto; white-space: nowrap; }
    h2 { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 4px; }
    h3 { font-size: 13px; font-weight: 700; color: #8c8f94; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; }
    .empty { padding: 32px; text-align: center; color: #8c8f94; font-size: 13px; }
  </style>

  <h2>대시보드</h2>

  <div class="stats">
    <div class="stat"><div class="stat-num" id="s-posts">-</div><div class="stat-lbl">게시글</div></div>
    <div class="stat"><div class="stat-num" id="s-pages">-</div><div class="stat-lbl">페이지</div></div>
    <div class="stat"><div class="stat-num" id="s-media">-</div><div class="stat-lbl">미디어</div></div>
    <div class="stat"><div class="stat-num" id="s-comments">-</div><div class="stat-lbl">댓글</div></div>
  </div>

  <h3>빠른 실행</h3>
  <div class="quick">
    <a class="qbtn" href="/admin/posts/new"><span class="qi">✏️</span>새 글 쓰기</a>
    <a class="qbtn" href="/admin/pages/new"><span class="qi">📄</span>새 페이지</a>
    <a class="qbtn" href="/admin/media"><span class="qi">🖼️</span>미디어 업로드</a>
    <a class="qbtn" href="/admin/plugins"><span class="qi">🔌</span>플러그인</a>
    <a class="qbtn" href="/admin/themes"><span class="qi">🎨</span>테마</a>
    <a class="qbtn" href="/admin/settings"><span class="qi">⚙️</span>설정</a>
  </div>

  <h3>최근 게시글</h3>
  <div class="recent">
    <div class="recent-hd">최근 게시글</div>
    <div id="posts-list"><div class="empty">로딩 중...</div></div>
  </div>

  <script>
    function escHtml(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
    async function loadDashboard() {
      try {
        const res  = await fetch('/api/posts?per_page=8');
        const data = await res.json();
        document.getElementById('s-posts').textContent    = String(data.total_posts    ?? '-');
        document.getElementById('s-pages').textContent    = String(data.total_pages_count ?? '-');
        document.getElementById('s-media').textContent    = String(data.total_media    ?? '-');
        document.getElementById('s-comments').textContent = String(data.total_comments  ?? '-');
        const posts = data.posts || [];
        const el = document.getElementById('posts-list');
        if (!posts.length) { el.innerHTML = '<div class="empty">아직 게시글이 없습니다. <a href="/admin/posts/new" style="color:#2271b1;">첫 글을 작성해보세요!</a></div>'; return; }
        el.innerHTML = posts.map((p: any) => `
          <div class="recent-row">
            <div>
              <a class="recent-title" href="/admin/posts/${p.ID}/edit">${escHtml(p.post_title||'(제목 없음)')}</a>
              <div class="recent-meta">${escHtml(p.post_status||'')}</div>
            </div>
            <span class="recent-date">${p.post_date ? new Date(p.post_date).toLocaleDateString('ko-KR') : ''}</span>
          </div>`).join('');
      } catch(e) { document.getElementById('posts-list').innerHTML = '<div class="empty" style="color:#f87171;">로드 실패</div>'; }
    }
    loadDashboard();
  </script>
</CmsLayout>
