{
  "name": "cf-wordpress",
  "version": "1.0.0",
  "description": "클라우드플레어 기반 워드프레스",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply cfwp-db",
    "db:migrate:local": "wrangler d1 migrations apply cfwp-db --local",
    "build": "tsc --noEmit && esbuild worker/src/index.ts --bundle --outfile=dist/worker.js --platform=browser --target=es2022 --format=esm --external:node:*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "itty-router": "^5.0.18"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
